/* pages/detail/detail.wxss */
.detail-container {
  position: relative;
  min-height: 100vh;
  background-color: #0F1115;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
  padding: 40rpx 36rpx 60rpx 36rpx;
  box-sizing: border-box;
  overflow: hidden;
}

/* 沉浸式高斯模糊背景 */
.ambient-backdrop {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  filter: blur(50px) brightness(0.4);
  transform: scale(1.2);
  z-index: 1;
}

.ambient-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: radial-gradient(circle at center, transparent 30%, #0F1115 90%);
  z-index: 2;
}

/* 拍立得实体卡板 */
.polaroid-wrapper {
  position: relative;
  z-index: 10;
  width: 100%;
  display: flex;
  justify-content: center;
}

.polaroid-board {
  width: 92%;
  background: #F8F8F8;
  border-radius: 16rpx;
  padding: 24rpx 24rpx 40rpx 24rpx;
  box-shadow: 0 30rpx 60rpx rgba(0, 0, 0, 0.75), 0 0 0 1rpx rgba(255, 255, 255, 0.2);
  box-sizing: border-box;
}

.photo-viewport {
  position: relative;
  width: 100%;
  background: #111;
  border-radius: 8rpx;
  overflow: hidden;
}

.core-image {
  width: 100%;
  display: block;
  transition: filter 0.8s ease;
}

/* 显影控制 */
.core-image.darkroom-hidden {
  filter: blur(8rpx);
}

.core-image.revealed {
  filter: blur(0);
}

.darkroom-mask {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: opacity 0.5s ease;
}

.mini-tip-capsule {
  background: rgba(15, 17, 21, 0.75);
  border: 1rpx solid rgba(229, 192, 123, 0.4);
  backdrop-filter: blur(8px);
  padding: 10rpx 24rpx;
  border-radius: 30rpx;
  font-size: 22rpx;
  color: #E5C07B;
  font-weight: 500;
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.4);
}

/* [新增] 本人专属销毁底片微光按钮 */
.owner-delete-tag {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  background: rgba(220, 38, 38, 0.85);
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  backdrop-filter: blur(10px);
  color: #FFFFFF;
  font-size: 20rpx;
  font-weight: 600;
  padding: 8rpx 20rpx;
  border-radius: 26rpx;
  box-shadow: 0 4rpx 16rpx rgba(220, 38, 38, 0.45);
}

/* 拍立得相纸底部留白信息 */
.polaroid-meta-board {
  padding-top: 24rpx;
}

.meta-main-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.author-block {
  display: flex;
  align-items: center;
}

.author-avatar {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  margin-right: 12rpx;
  border: 1rpx solid #E5C07B;
}

.author-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #111827;
}

.film-stamp {
  font-family: "Courier New", monospace;
  font-size: 20rpx;
  color: #9CA3AF;
  letter-spacing: 1rpx;
}

.meta-caption {
  display: block;
  margin-top: 16rpx;
  font-size: 26rpx;
  line-height: 1.5;
  color: #374151;
}

.location-chip {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #B45309;
}

/* 留声机播放胶囊条 */
.audio-capsule-bar {
  margin-top: 20rpx;
  background: #11141A;
  border-radius: 20rpx;
  padding: 14rpx 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border: 1rpx solid rgba(229, 192, 123, 0.3);
}

.audio-play-icon {
  font-size: 28rpx;
  color: #E5C07B;
  margin-right: 14rpx;
}

.audio-track-info {
  display: flex;
  flex-direction: column;
  flex: 1;
}

.track-title {
  font-size: 22rpx;
  color: #F3F4F6;
  font-weight: 500;
}

.track-duration {
  font-size: 18rpx;
  color: #9CA3AF;
}

.audio-waveform-static {
  color: #4EC9B0;
  letter-spacing: 4rpx;
  font-size: 24rpx;
}

.audio-waveform-dynamic {
  display: flex;
  gap: 4rpx;
}

.live-bar {
  width: 4rpx;
  background: #4EC9B0;
  border-radius: 2rpx;
  animation: liveWave 0.5s infinite alternate;
}
.a1 { height: 10rpx; animation-delay: 0.1s; }
.a2 { height: 24rpx; animation-delay: 0.2s; }
.a3 { height: 16rpx; animation-delay: 0.3s; }
.a4 { height: 20rpx; animation-delay: 0.15s; }

@keyframes liveWave {
  from { height: 6rpx; }
  to { height: 26rpx; }
}

/* 四列等宽栅格排版 */
.action-grid-fixed {
  position: relative;
  z-index: 10;
  width: 100%;
  display: flex;
  justify-content: space-around;
  align-items: flex-start;
  padding: 30rpx 10rpx 0 10rpx;
  box-sizing: border-box;
}

.action-col {
  width: 160rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.action-circle {
  width: 90rpx;
  height: 90rpx;
  background: rgba(26, 30, 40, 0.85);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  backdrop-filter: blur(15px);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  box-shadow: 0 12rpx 28rpx rgba(0, 0, 0, 0.4);
}

.poster-circle {
  border-color: #E5C07B;
  background: rgba(229, 192, 123, 0.15);
  box-shadow: 0 12rpx 28rpx rgba(229, 192, 123, 0.25);
}

.action-text {
  font-size: 22rpx;
  color: #9CA3AF;
  margin-top: 14rpx;
  white-space: nowrap;
  text-align: center;
  letter-spacing: 1rpx;
}

.poster-text {
  color: #E5C07B;
  font-weight: 600;
}

button.share-clean-btn {
  background: transparent !important;
  border: none !important;
  padding: 0 !important;
  margin: 0 !important;
  line-height: normal !important;
  outline: none !important;
}

button.share-clean-btn::after {
  display: none !important;
}

/* 离屏隐藏 Canvas */
.poster-canvas-hidden {
  position: fixed;
  left: -9999px;
  top: -9999px;
  width: 750px;
  height: 1050px;
}