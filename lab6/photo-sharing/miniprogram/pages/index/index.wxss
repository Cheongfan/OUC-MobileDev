/* pages/index/index.wxss */
.home-container {
  min-height: 100vh;
  background-color: #0F1115;
  padding-bottom: 120rpx;
}

/* 顶部账号与分段控制器 */
.home-top-bar {
  position: sticky;
  top: 0;
  z-index: 100;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18rpx 32rpx;
  background: rgba(15, 17, 21, 0.92);
  backdrop-filter: blur(15px);
  -webkit-backdrop-filter: blur(15px);
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.06);
}

.user-account-pill {
  display: flex;
  align-items: center;
  background: rgba(28, 31, 38, 0.85);
  border: 1rpx solid rgba(229, 192, 123, 0.25);
  padding: 8rpx 18rpx 8rpx 8rpx;
  border-radius: 40rpx;
}

.my-avatar {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  border: 2rpx solid #E5C07B;
  margin-right: 12rpx;
}

.my-info {
  display: flex;
  flex-direction: column;
}

.my-name {
  font-size: 22rpx;
  color: #F3F4F6;
  font-weight: 600;
}

.my-badge {
  font-size: 18rpx;
  color: #E5C07B;
}

.switch-capsule {
  display: flex;
  background: #1C1F26;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 40rpx;
  padding: 6rpx;
}

.capsule-item {
  padding: 10rpx 28rpx;
  font-size: 24rpx;
  color: #9CA3AF;
  border-radius: 32rpx;
  transition: all 0.3s cubic-bezier(0.25, 1, 0.5, 1);
}

.capsule-item.active {
  background: #E5C07B;
  color: #0F1115;
  font-weight: 600;
  box-shadow: 0 4rpx 16rpx rgba(229, 192, 123, 0.35);
}

/* 拍立得卡片流 */
.photo-feed {
  padding: 24rpx 36rpx;
}

.polaroid-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  margin-bottom: 50rpx;
  padding: 24rpx 24rpx 32rpx 24rpx;
  box-shadow: 0 16rpx 36rpx rgba(0, 0, 0, 0.6), 0 2rpx 8rpx rgba(0, 0, 0, 0.2);
  color: #1A1A1A;
  position: relative;
}

.card-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.author-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  border: 2rpx solid #E5C07B;
  margin-right: 18rpx;
}

.author-meta {
  display: flex;
  flex-direction: column;
}

.author-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #111827;
}

.sub-line {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 4rpx;
}

.location-tag, .time-tag {
  font-size: 22rpx;
  color: #6B7280;
}

.photo-frame {
  position: relative;
  width: 100%;
  background: #111;
  border-radius: 8rpx;
  overflow: hidden;
}

.main-image {
  width: 100%;
  display: block;
  transition: filter 0.4s ease;
}

.main-image.darkroom-blur {
  filter: blur(8rpx);
}

.darkroom-tag {
  position: absolute;
  top: 16rpx;
  left: 16rpx;
  background: rgba(15, 17, 21, 0.72);
  border: 1rpx solid rgba(229, 192, 123, 0.35);
  backdrop-filter: blur(8px);
  padding: 6rpx 16rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  pointer-events: none;
}

.flask-text {
  font-size: 20rpx;
  color: #E5C07B;
  font-weight: 500;
  letter-spacing: 1rpx;
}

.vinyl-capsule {
  position: absolute;
  right: 18rpx;
  bottom: 18rpx;
  background: rgba(15, 17, 21, 0.85);
  border: 1rpx solid rgba(255, 255, 255, 0.18);
  border-radius: 36rpx;
  padding: 6rpx 18rpx 6rpx 8rpx;
  display: flex;
  align-items: center;
  backdrop-filter: blur(10px);
  z-index: 10;
}

.vinyl-disc {
  width: 40rpx;
  height: 40rpx;
  background: #111;
  border-radius: 50%;
  border: 2rpx solid #333;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 10rpx;
}

.vinyl-groove {
  width: 22rpx;
  height: 22rpx;
  border-radius: 50%;
  border: 1rpx dashed #555;
}

.vinyl-center {
  position: absolute;
  width: 8rpx;
  height: 8rpx;
  background: #E5C07B;
  border-radius: 50%;
}

.voice-hint {
  font-size: 18rpx;
  color: #F3F4F6;
  font-weight: 500;
}

@keyframes spinDisc {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.vinyl-capsule.playing .vinyl-disc {
  animation: spinDisc 2.5s linear infinite;
}

.heart-burst-box {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  pointer-events: none;
}

.burst-heart {
  font-size: 140rpx;
  animation: heartPop 0.8s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
}

@keyframes heartPop {
  0% { transform: scale(0.2); opacity: 0; }
  50% { transform: scale(1.3); opacity: 1; }
  100% { transform: scale(1.0); opacity: 0; }
}

.polaroid-bottom {
  padding-top: 24rpx;
}

.card-caption {
  font-size: 28rpx;
  color: #374151;
  line-height: 1.5;
  margin-bottom: 20rpx;
  display: block;
}

.action-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-top: 1rpx dashed #D1D5DB;
  padding-top: 18rpx;
}

.date-stamp {
  font-family: "Courier New", Courier, monospace;
  font-size: 20rpx;
  color: #9CA3AF;
  letter-spacing: 2rpx;
}

.like-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.like-icon { font-size: 32rpx; }
.like-count { font-size: 24rpx; color: #6B7280; font-weight: 600; }
.like-count.liked-text { color: #FF4757; }

.empty-hint-box {
  margin: 100rpx auto;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: 40rpx;
}

.empty-icon { font-size: 80rpx; margin-bottom: 20rpx; }
.empty-title { font-size: 30rpx; color: #E5E7EB; font-weight: 600; margin-bottom: 12rpx; }
.empty-sub { font-size: 22rpx; color: #6B7280; line-height: 1.6; max-width: 500rpx; margin-bottom: 36rpx; }
.empty-seed-btn {
  background: #E5C07B !important;
  color: #0F1115 !important;
  font-size: 24rpx !important;
  font-weight: 700 !important;
  border-radius: 36rpx !important;
  padding: 12rpx 36rpx !important;
}

/* 地图视图 */
.map-wrapper {
  position: relative;
  width: 100vw;
  height: calc(100vh - 120rpx);
}

.custom-map {
  width: 100%;
  height: 100%;
}

.avatar-callout-box {
  display: flex;
  align-items: center;
  background: #0F1115;
  border: 2rpx solid #E5C07B;
  border-radius: 40rpx;
  padding: 6rpx 16rpx 6rpx 6rpx;
  box-shadow: 0 10rpx 20rpx rgba(0, 0, 0, 0.6);
}

.callout-avatar {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  margin-right: 10rpx;
}

.callout-meta {
  display: flex;
  flex-direction: column;
}

.callout-title {
  font-size: 20rpx;
  color: #E5C07B;
  font-weight: 700;
}

.callout-author {
  font-size: 16rpx;
  color: #D1D5DB;
}

.map-photo-carousel {
  position: absolute;
  bottom: 40rpx;
  left: 0;
  right: 0;
  z-index: 99;
  padding: 0 20rpx;
}

.carousel-scroll {
  display: flex;
  white-space: nowrap;
  padding-bottom: 10rpx;
}

.carousel-card {
  display: inline-flex;
  width: 520rpx;
  background: rgba(26, 29, 36, 0.94);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  backdrop-filter: blur(20px);
  border-radius: 20rpx;
  padding: 16rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
  box-shadow: 0 16rpx 36rpx rgba(0, 0, 0, 0.6);
  transition: all 0.3s ease;
}

.carousel-card.card-highlight {
  border-color: #E5C07B;
  transform: translateY(-8rpx);
  box-shadow: 0 20rpx 40rpx rgba(229, 192, 123, 0.3);
}

.carousel-img {
  width: 150rpx;
  height: 150rpx;
  border-radius: 14rpx;
  flex-shrink: 0;
}

.carousel-info {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  margin-left: 18rpx;
  flex: 1;
}

.carousel-place {
  font-size: 26rpx;
  font-weight: 700;
  color: #E5C07B;
  white-space: normal;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 1;
  overflow: hidden;
}

.carousel-author {
  font-size: 22rpx;
  color: #9CA3AF;
}

.carousel-btn {
  align-self: flex-start;
  font-size: 22rpx;
  color: #4EC9B0;
  font-weight: 600;
  padding: 6rpx 14rpx;
  background: rgba(78, 201, 176, 0.12);
  border-radius: 12rpx;
}

/* [核心改造] 拟物悬浮定格相机按钮 (重置原生 button，使其兼顾 getUserInfo 授权与拟物视觉) */
button.fab-upload-btn {
  position: fixed;
  right: 40rpx;
  bottom: 60rpx;
  width: 124rpx !important;
  height: 124rpx !important;
  padding: 0 !important;
  margin: 0 !important;
  border-radius: 50% !important;
  background: #1E222B !important;
  border: 4rpx solid #E5C07B !important;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 16rpx 36rpx rgba(0, 0, 0, 0.5), 0 0 20rpx rgba(229, 192, 123, 0.3) !important;
  z-index: 101;
  line-height: normal !important;
}

button.fab-upload-btn::after {
  display: none !important;
}

.camera-lens {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #0B0D11;
  border: 4rpx solid #4B5563;
  position: relative;
}

.lens-reflection {
  position: absolute;
  top: 6rpx;
  right: 8rpx;
  width: 10rpx;
  height: 10rpx;
  background: rgba(255, 255, 255, 0.6);
  border-radius: 50%;
}

.fab-text {
  font-size: 18rpx;
  color: #E5C07B;
  font-weight: 700;
  margin-top: 4rpx;
  letter-spacing: 2rpx;
}