/* 全局页面背景色 */
page {
  background-color: #f6f7f9;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, Segoe UI, Arial, Roboto, sans-serif;
}

/* 全局卡片式新闻列表 */
.news-list {
  padding: 20rpx 24rpx;
}

/* 独立新闻卡片 */
.news-item {
  display: flex;
  flex-direction: row;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  transition: all 0.2s ease;
}

/* 按压卡片时的微缩反馈 */
.news-item:active {
  transform: scale(0.98);
  background-color: #f9f9f9;
}

/* 缩放海报图 */
.news-item image {
  width: 210rpx;
  height: 140rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  margin-right: 20rpx;
}

/* 新闻右侧文本容器 */
.news-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  overflow: hidden;
}

/* 新闻标题（最多两行，超长省略号） */
.news-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #222222;
  line-height: 42rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 底部元信息栏 */
.news-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 10rpx;
}

/* 蓝色分类小胶囊 */
.news-tag {
  font-size: 22rpx;
  color: #328EEB;
  background: rgba(50, 142, 235, 0.1);
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  font-weight: 500;
}

/* 灰色日期 */
.news-date {
  font-size: 24rpx;
  color: #999999;
}