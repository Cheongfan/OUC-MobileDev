/* 1. 渐变个人信息头部 */
.profile-header {
  background: linear-gradient(135deg, #2575fc 0%, #328eeb 100%);
  padding: 60rpx 0 50rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 20rpx rgba(50, 142, 235, 0.2);
}

.avatar-box {
  width: 170rpx;
  height: 170rpx;
  border-radius: 50%;
  background: #ffffff;
  padding: 6rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
  margin-bottom: 20rpx;
}

.avatar {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.nickname {
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.login-btn {
  background: #ffffff !important;
  color: #328eeb !important;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 40rpx;
  padding: 16rpx 50rpx !important;
  box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.1);
}

/* 2. 收藏列表标题栏 */
.favorite-section {
  padding: 30rpx 0;
}

.section-header {
  padding: 0 30rpx 10rpx 30rpx;
}

.section-title {
  display: flex;
  align-items: center;
}

.title-bar {
  width: 8rpx;
  height: 32rpx;
  background: #328eeb;
  border-radius: 4rpx;
  margin-right: 16rpx;
}

.title-text {
  font-size: 32rpx;
  font-weight: 700;
  color: #222222;
}

.count-badge {
  font-size: 26rpx;
  color: #888888;
  margin-left: 10rpx;
}

/* 空状态卡片 */
.empty-card {
  background: #ffffff;
  margin: 20rpx 24rpx;
  padding: 60rpx 30rpx;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.03);
}

.empty-icon {
  font-size: 60rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999999;
}

/* 💡 新增：退出登录按钮样式 */
.logout-btn {
  margin-top: 24rpx !important;
  background: rgba(255, 255, 255, 0.2) !important;
  color: #ffffff !important;
  border: 1rpx solid rgba(255, 255, 255, 0.6);
  font-size: 24rpx;
  border-radius: 30rpx;
  padding: 8rpx 36rpx !important;
  font-weight: normal;
  display: inline-block;
}

.logout-btn:active {
  background: rgba(255, 255, 255, 0.35) !important;
}