/* 💡 补全：吸顶 Tab 分类栏样式 (解决选项竖着排列的问题) */
.tab-bar {
  white-space: nowrap;
  height: 88rpx;
  background: #ffffff;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.03);
  position: sticky;
  top: 0;
  z-index: 100;
}

.tab-item {
  display: inline-block;
  padding: 0 32rpx;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 28rpx;
  color: #666666;
  position: relative;
}

.tab-item.active {
  color: #328EEB;
  font-weight: 600;
  font-size: 30rpx;
}

.tab-line {
  position: absolute;
  bottom: 8rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 6rpx;
  background: #328EEB;
  border-radius: 3rpx;
}

/* 轮播图容器 */
.swiper-wrapper {
  padding: 20rpx 24rpx 10rpx 24rpx;
}

swiper {
  height: 380rpx;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(50, 142, 235, 0.15);
  position: relative;
}

.swiper-img {
  width: 100%;
  height: 100%;
  border-radius: 20rpx;
}

/* 轮播图底部黑色渐变文字遮罩 */
.swiper-title-box {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 40rpx 20rpx 20rpx 20rpx;
  background: linear-gradient(to top, rgba(0, 0, 0, 0.75), transparent);
  border-bottom-left-radius: 20rpx;
  border-bottom-right-radius: 20rpx;
  pointer-events: none;
}

.swiper-title {
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 38rpx;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  overflow: hidden;
  text-overflow: ellipsis;
}

.empty-tip {
  text-align: center;
  padding: 60rpx 0;
  color: #999999;
  font-size: 28rpx;
}