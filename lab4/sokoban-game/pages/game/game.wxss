.header-info {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
}

.stat-bar {
  display: flex;
  justify-content: space-around;
  width: 80%;
  font-size: 12pt;
  color: #666;
  margin-top: 10rpx;
}

.canvas-area {
  margin: 15rpx 0;
  border: 4rpx solid #E64340;
  border-radius: 8rpx;
  box-shadow: 0 4rpx 10rpx rgba(0,0,0,0.15);
}

.myCanvas {
  width: 320px;
  height: 320px;
}

.action-bar {
  display: flex;
  justify-content: space-between;
  width: 70%;
  margin-bottom: 10rpx;
}

.action-btn {
  font-size: 10pt;
  padding: 0 30rpx;
  height: 60rpx;
  line-height: 60rpx;
  border-radius: 30rpx;
  background-color: #e0e0e0;
}

.btnBox {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 20rpx;
}

.middle-row {
  display: flex;
  flex-direction: row;
}

.dir-btn {
  width: 100rpx !important;
  height: 100rpx !important;
  line-height: 100rpx !important;
  padding: 0 !important;
  margin: 10rpx !important;
  font-size: 14pt;
  border-radius: 50%;
  box-shadow: 0 4rpx 6rpx rgba(0,0,0,0.2);
}