.container { min-height: 100vh; background: #241c18; padding: 24rpx; }
.title { font-size: 16pt; font-weight: bold; color: #f7b731; margin-bottom: 24rpx; text-align: center; }
.progress-card { background: #362a22; border: 4rpx solid #5a4535; padding: 24rpx; margin-bottom: 24rpx; }
.card-label { font-size: 10pt; font-weight: bold; color: #f7b731; margin-bottom: 12rpx; }
.progress-bar-box { width: 100%; height: 24rpx; background: #17110e; border: 2rpx solid #5a4535; border-radius: 12rpx; overflow: hidden; }
.progress-fill { height: 100%; background: linear-gradient(90deg, #f7b731, #2ed573); }
.progress-text { font-size: 8pt; color: #a4b0be; margin-top: 10rpx; text-align: right; }

.stats-grid { display: flex; flex-wrap: wrap; justify-content: space-between; }
.grid-item { width: 48%; background: #362a22; border: 4rpx solid #5a4535; border-radius: 12rpx; padding: 20rpx; box-sizing: border-box; margin-bottom: 24rpx; text-align: center; }
.item-icon { font-size: 20pt; }
.item-val { font-size: 15pt; font-weight: bold; color: #f7b731; margin-top: 8rpx; }
.item-lbl { font-size: 8pt; color: #a4b0be; margin-top: 4rpx; }