}
.tag-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background-color: #FF5353;
  margin-right: 8rpx;
}
.dye-theme-teal .tag-dot { background-color: #06D6A0; }
.dye-theme-purple .tag-dot { background-color: #9D4EDD; }
.dye-theme-yellow .tag-dot { background-color: #FFD23F; }
.card-serial {
  font-size: 18rpx;
  font-family: monospace;
  color: #A8A29E;
  font-weight: 800;
}

.stamp-badge {
  position: absolute;
  top: 50rpx;
  padding: 12rpx 26rpx;
  font-size: 32rpx;
  font-weight: 900;
  border: 5rpx solid #1C1917;
  border-radius: 14rpx;
