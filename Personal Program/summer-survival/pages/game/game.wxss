/* pages/game/game.wxss */
.game-viewport {
  height: 100vh;
  padding: 14rpx 24rpx 28rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  overflow: hidden;
  box-sizing: border-box;
  background-color: #FDFBF7;
  background-image: radial-gradient(#E2DDD3 1.5rpx, transparent 1.5rpx);
  background-size: 24rpx 24rpx;
}

/* 顶部进度条 */
.timeline-bar-wrap {
  padding: 18rpx 20rpx 14rpx;
  margin-top: 8rpx;
  margin-bottom: 12rpx;
  background-color: #FFFFFF;
}
.timeline-header {
  margin-bottom: 12rpx;
}
.timeline-pulse-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background-color: #FF5353;
  margin-right: 10rpx;
  animation: pulseDot 1s infinite;
}
.timeline-title {
  font-size: 22rpx;
  font-weight: 900;
  color: #1C1917;
  letter-spacing: 1rpx;
}
.dev-test-pill {
  font-size: 18rpx;
  font-weight: 900;
  background-color: #FEFCBF;
  color: #D69E2E;
  border: 2rpx solid #1C1917;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
}
.timeline-counter {
  font-size: 24rpx;
  font-weight: 900;
  font-family: monospace;
  color: #FF5353;
  background-color: #FFE4E6;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  border: 3rpx solid #1C1917;
}

.progress-track-outer {
  width: 100%;
  height: 18rpx;
  background-color: #F4EFE6;
  border: 3rpx solid #1C1917;
  border-radius: 99rpx;
  position: relative;
  overflow: visible;
  margin-top: 18rpx;
  margin-bottom: 4rpx;
}
.progress-track-inner {
  height: 100%;
  background-color: #06D6A0 !important;
  border-radius: 99rpx;
  transition: width 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
}

/* 严格按 25%、50%、75%、100% 均分间距定位的 4 个事件旗标 */
.flag-milestone {
  position: absolute;
  top: -30rpx;
  font-size: 18rpx;
  font-weight: 900;
  background-color: #FFFFFF;
  border: 3rpx solid #1C1917;
  padding: 2rpx 8rpx;
  border-radius: 6rpx;
  color: #78716C;
  box-shadow: 2rpx 2rpx 0rpx #1C1917;
  z-index: 20;
  transform: translateX(-50%);
  white-space: nowrap;
}
.flag-15 { left: 25%; }
.flag-30 { left: 50%; }
.flag-45 { left: 75%; }
.flag-60 { left: 100%; }

.flag-milestone.active {
  background-color: #FFED66 !important;
  color: #1C1917 !important;
  transform: translateX(-50%) scale(1.1);
}

/* 四维状态栏：重构 flex 比例，给“妈见打指数”开辟宽裕空间，彻底防止换行 */
.status-hud {
  padding: 12rpx 12rpx;
  background-color: #FFFFFF;
  margin-bottom: 12rpx;
  display: flex !important;
  flex-direction: row !important;
  justify-content: space-between !important;
  align-items: center;
}
.hud-item {
  flex: 1;
  align-items: center;
  position: relative;
  padding: 0 4rpx;
  min-width: 0;
}
/* 给“妈见打指数”卡片给予更大的 flex 权重，防止文字过长挤压 */
.hud-item-rage {
  flex: 1.5 !important;
}
.hud-top {
  width: 100%;
}
.hud-icon { font-size: 22rpx; }
.hud-val {
  font-size: 24rpx;
  font-weight: 900;
  font-family: monospace;
}
.hud-bar {
  width: 100%;
  height: 12rpx;
  background-color: #E7E5E4;
  border: 2rpx solid #1C1917;
  border-radius: 99rpx;
  overflow: hidden;
  margin: 4rpx 0;
}

.hud-fill {
  height: 100%;
  transition: width 0.3s ease;
  border-radius: 99rpx;
}
.bar-stamina { background-color: #10B981 !important; }
.bar-money { background-color: #F59E0B !important; }
.bar-sanity { background-color: #06B6D4 !important; }
.bar-rage { background-color: #EF4444 !important; }

.hud-name {
  font-size: 16rpx;
  font-weight: 900;
  color: #78716C;
  white-space: nowrap; /* 强制不换行 */
  overflow: hidden;
  text-overflow: ellipsis;
  width: 100%;
  text-align: center;
}
.delta-chip {
  position: absolute;
  top: -16rpx;
  right: -2rpx;
  font-size: 20rpx;
  font-weight: 900;
  font-family: monospace;
}
.delta-chip.up { color: #10B981; }
.delta-chip.down { color: #EF4444; }
.danger-blink { color: #EF4444 !important; animation: pulseDanger 0.5s infinite; }

/* 居中舞台 */
.card-stage-container {
  flex: 1;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
  min-height: 0;
}
.card-entity {
  width: 100%;
  height: 100%;
  background-color: #FFFFFF !important;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  border-width: 5rpx !important;
  border-color: #1C1917 !important;
