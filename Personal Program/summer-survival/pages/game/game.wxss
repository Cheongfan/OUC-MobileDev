.stamp-left { left: 18rpx; transform: rotate(-14deg); background-color: #FFED66; color: #1C1917; }
.stamp-right { right: 18rpx; transform: rotate(14deg); background-color: #FF5353; color: #FFFFFF; }

.ai-verdict-stamp {
  position: absolute;
