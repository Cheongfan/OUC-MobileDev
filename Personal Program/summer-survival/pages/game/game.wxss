/* 四维状态栏：4个状态项平均分配宽度，整齐划一 */
.status-hud {
  padding: 12rpx 10rpx;
  background-color: #FFFFFF;
  margin-bottom: 12rpx;
  display: flex !important;
  flex-direction: row !important;
  justify-content: space-between !important;
  align-items: center;
}
.hud-item {
  flex: 1; /* 四项平分宽度，长短绝对一致 */
  align-items: center;
  position: relative;
  padding: 0 4rpx;
  min-width: 0;
}
.hud-item-rage {
  flex: 1 !important; /* 恢复与其他三项完全一致的均分比例 */
}
.hud-top {
  width: 100%;
}
.hud-icon { font-size: 20rpx; }
.hud-val {
  font-size: 24rpx;
  font-weight: 900;
  font-family: monospace;
}
.hud-bar {
  width: 100%;
  height: 12rpx;
  background-color: #E7E5E4;
  border: 2rpx solid #1C1917;
  border-radius: 99rpx;
  overflow: hidden;
  margin: 4rpx 0;
}

.hud-fill {
  height: 100%;
  transition: width 0.3s ease;
  border-radius: 99rpx;
}
.bar-stamina { background-color: #10B981 !important; }
.bar-money { background-color: #F59E0B !important; }
.bar-sanity { background-color: #06B6D4 !important; }
.bar-rage { background-color: #EF4444 !important; }

/* 底部文字：微缩字号 + 强制不换行，保证“妈见打指数”完美单行显示 */
.hud-name {
  font-size: 15rpx;
  font-weight: 900;
  color: #78716C;
  white-space: nowrap; 
  overflow: visible;
  text-align: center;
  width: 100%;
}
.delta-chip {
  position: absolute;
  top: -16rpx;
  right: -2rpx;
  font-size: 20rpx;
  font-weight: 900;
  font-family: monospace;
}
.delta-chip.up { color: #10B981; }
.delta-chip.down { color: #EF4444; }
.danger-blink { color: #EF4444 !important; animation: pulseDanger 0.5s infinite; }

@keyframes blink { 0%, 100% { opacity: 1; } 50% { opacity: 0; } }
@keyframes pulseDot { 0%, 100% { opacity: 0.4; } 50% { opacity: 1; } }
@keyframes pulseGreen { 0%, 100% { opacity: 0.3; } 50% { opacity: 1; } }
@keyframes pulseDanger { 0%, 100% { opacity: 1; } 50% { opacity: 0.4; } }