}

.dye-theme-red { border-top: 16rpx solid #FF5353 !important; }
.dye-theme-teal { border-top: 16rpx solid #06D6A0 !important; }
.dye-theme-purple { border-top: 16rpx solid #9D4EDD !important; }
.dye-theme-yellow { border-top: 16rpx solid #FFD23F !important; }

.dye-paint-banner {
  border-bottom: 2rpx dashed #E7E5E4;
  padding-bottom: 8rpx;
}
.dye-tag-text {
  font-size: 20rpx;
