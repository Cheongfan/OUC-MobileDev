.multitask-viewport {
  height: 100vh;
  padding: 16rpx 20rpx 24rpx;
  background-color: #FDFBF7;
  justify-content: space-between;
  overflow: hidden;
  box-sizing: border-box;
}

/* 顶部 CPU 监控 */
.cpu-monitor-hud {
  padding: 14rpx 18rpx;
  background-color: #FFFFFF;
}
.timer-col {
  width: 150rpx;
}
.hud-label {
  font-size: 16rpx;
  font-weight: 800;
  color: #78716C;
}
.survive-time {
  font-size: 40rpx;
  font-weight: 900;
  font-family: monospace;
  color: #FF5353;
  line-height: 1;
}
.unit-s { font-size: 18rpx; }

.stress-col {
  flex: 1;
  margin-left: 20rpx;
}
.stress-title-row {
  margin-bottom: 6rpx;
}
.stress-title {
  font-size: 18rpx;
  font-weight: 900;
  color: #1C1917;
}
.stress-pct {
  font-size: 22rpx;
  font-weight: 900;
  font-family: monospace;
}
.stress-track {
  width: 100%;
  height: 14rpx;
  background-color: #F4EFE6;
  border: 2rpx solid #1C1917;
  border-radius: 99rpx;
  overflow: hidden;
}
.stress-fill {
  height: 100%;
  transition: width 0.1s linear;
}
.danger-blink {
  color: #FF5353 !important;
  animation: pulseAnimation 0.5s infinite;
}

.dual-stream-row {
  display: flex !important;
  flex-direction: row !important;
  justify-content: space-between !important;
  width: 100% !important;
  flex: 1;
  margin: 12rpx 0;
  gap: 14rpx;
  box-sizing: border-box;
  overflow: hidden;
}

.sub-stage {
  width: calc(50% - 7rpx) !important;
  max-width: calc(50% - 7rpx) !important;
  min-width: 0 !important;
  height: 100%;
  background-color: #FFFFFF;
  padding: 12rpx;
  box-sizing: border-box;
  justify-content: space-between;
}

.thread-header {
  border-bottom: 2rpx dashed #E7E5E4;
  padding-bottom: 6rpx;
  margin-bottom: 6rpx;
}
.thread-name {
  font-size: 18rpx;
  font-weight: 900;
  color: #1C1917;
}
.deviation-tag {
  font-size: 16rpx;
  font-weight: 800;
  color: #06D6A0;
}
.tag-danger {
  color: #FF5353 !important;
}
.chat-timer {
  font-size: 16rpx;
  font-weight: 900;
  color: #FF5353;
  font-family: monospace;
}

/* 左屏：车道 */
.lane-track {
  flex: 1;
  background-color: #2D3748;
  border: 3rpx solid #1C1917;
  border-radius: 12rpx;
  position: relative;
  overflow: hidden;
  margin-bottom: 8rpx;
  min-height: 280rpx;
}
.lane-curb-l {
  position: absolute;
  left: 10rpx;
  top: 0;
  bottom: 0;
  width: 6rpx;
  background-color: #FF5353;
}
.lane-curb-r {
  position: absolute;
  right: 10rpx;
  top: 0;
  bottom: 0;
  width: 6rpx;
  background-color: #FF5353;
}
.lane-center-line {
  position: absolute;
  left: 50%;
  top: 0;
  bottom: 0;
  width: 4rpx;
  border-left: 4rpx dashed #FFD23F;
}
.moving-car {
  position: absolute;
  bottom: 24rpx;
  transform: translateX(-50%);
  transition: left 0.08s linear;
}
.car-glyph { font-size: 46rpx; }

.steer-btn-group {
  gap: 8rpx;
  width: 100%;
}
.steer-chip {
  flex: 1;
  padding: 14rpx 0;
  background-color: #FFED66;
  border-radius: 10rpx;
}
.chip-text {
  font-size: 20rpx;
  font-weight: 900;
  color: #1C1917;
}

/* 右屏：微信消息 */
.chat-bubble-view {
  background-color: #F8FAFC;
  border: 2rpx solid #E2E8F0;
  border-radius: 10rpx;
  padding: 8rpx;
  margin-bottom: 8rpx;
  min-height: 120rpx;
}
.chat-sender {
  font-size: 16rpx;
  font-weight: 900;
  color: #06D6A0;
}
.chat-content {
  font-size: 18rpx;
  color: #1C1917;
  font-weight: 700;
  margin-top: 4rpx;
  line-height: 1.3;
}
.reply-actions-col {
  gap: 8rpx;
}
.reply-choice-chip {
  width: 100%;
  padding: 12rpx 4rpx;
  background-color: #F4EFE6;
  border-radius: 10rpx;
}
.reply-text {
  font-size: 18rpx;
  font-weight: 800;
  color: #1C1917;
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 底层雷达 */
.bottom-stage {
  padding: 14rpx 18rpx;
  background-color: #FFFFFF;
  margin-bottom: 12rpx;
}
.radar-alert-red {
  background-color: #FFF5F5 !important;
  border-color: #FF5353 !important;
  box-shadow: 0 0 20rpx rgba(255, 83, 83, 0.4) !important;
}
.radar-info {
  flex: 1;
  margin-right: 18rpx;
}
.radar-tag-row {
  margin-bottom: 6rpx;
}
.radar-title {
  font-size: 18rpx;
  font-weight: 900;
  color: #1C1917;
}
.radar-status {
  font-size: 16rpx;
  font-weight: 800;
  color: #78716C;
}
.radar-track {
  width: 100%;
  height: 12rpx;
  background-color: #F4EFE6;
  border: 2rpx solid #1C1917;
  border-radius: 99rpx;
  overflow: hidden;
}
.radar-fill {
  height: 100%;
  transition: width 0.05s linear;
}

.act-innocent-btn {
  padding: 16rpx 20rpx;
  background-color: #06D6A0;
  border-radius: 12rpx;
}
.btn-danger-flash {
  background-color: #FF5353 !important;
  color: #FFFFFF !important;
  animation: pulseAnimation 0.4s infinite;
}
.btn-innocent-text {
  font-size: 20rpx;
  font-weight: 900;
}

.action-footer { width: 100%; }
.reset-btn {
  width: 100% !important;
  padding: 16rpx 0 !important;
  font-size: 22rpx;
  background-color: #F4EFE6 !important;
}

/* 结算弹窗 */
.overload-modal-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background-color: rgba(20, 21, 24, 0.75);
  z-index: 1000;
  padding: 40rpx;
}
.overload-dialog {
  width: 100%;
  padding: 32rpx 24rpx;
  background-color: #FFFFFF;
}
.overload-title {
  font-size: 32rpx;
  font-weight: 900;
  color: #FF5353;
}
.overload-avatar-box {
  width: 120rpx;
  height: 120rpx;
  background-color: #FED7D7;
  border: 3rpx solid #1C1917;
  border-radius: 20rpx;
  margin: 14rpx 0;
}
.overload-emoji { font-size: 64rpx; }
.overload-verdict {
  font-size: 20rpx;
  line-height: 1.5;
  color: #4A5568;
  font-weight: 700;
  text-align: center;
  margin-bottom: 20rpx;
}
.overload-stats {
  width: 100%;
  background-color: #F7FAFC;
  border: 2rpx solid #E2E8F0;
  border-radius: 12rpx;
  padding: 14rpx 8rpx;
  margin-bottom: 20rpx;
}
.ov-cell { flex: 1; text-align: center; }
.ov-val {
  font-size: 28rpx;
  font-weight: 900;
  color: #1C1917;
  font-family: monospace;
}
.ov-lbl {
  font-size: 15rpx;
  color: #78716C;
  font-weight: 700;
  margin-top: 2rpx;
}
.play-again-btn {
  width: 100% !important;
  font-size: 26rpx;
}

/* 收益提示通用居中和高质感边框 (正负收益分离配色) */
.reward-success-box, .reward-fail-box {
  font-size: 20rpx;
  font-weight: 900;
  padding: 10rpx 14rpx;
  border-radius: 8rpx;
  border: 2rpx solid #1C1917;
  width: 100%;
  text-align: center;
  display: block;
  box-sizing: border-box;
}
.reward-success-box {
  background-color: #DCFCE7 !important;
  color: #15803D !important;
}
.reward-fail-box {
  background-color: #FEE2E2 !important;
  color: #B91C1C !important;
}

/* 确保各个小游戏结算弹窗中的收益提示文字垂直绝对居中 */
.reward-success-box, .reward-fail-box {
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  text-align: center;
  box-sizing: border-box;
  min-height: 56rpx;
}
.reward-success-box {
  background-color: #DCFCE7 !important;
  color: #15803D !important;
}
.reward-fail-box {
  background-color: #FEE2E2 !important;
  color: #B91C1C !important;
}