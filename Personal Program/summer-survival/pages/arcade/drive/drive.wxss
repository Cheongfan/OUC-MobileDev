.drive-stage {
  height: 100vh;
  padding: 20rpx 28rpx 36rpx;
  background-color: #FDFBF7;
  justify-content: space-between;
  overflow: hidden;
}

/* 教练 HUD */
.coach-hud {
  padding: 18rpx 20rpx;
  background-color: #FFFFFF;
  margin-bottom: 14rpx;
}
.coach-avatar-box {
  width: 96rpx;
  height: 96rpx;
  background-color: #FFED66;
  border: 3rpx solid #1C1917;
  border-radius: 16rpx;
  font-size: 52rpx;
}
.coach-status-col {
  flex: 1;
  margin-left: 18rpx;
}
.status-title-row {
  margin-bottom: 6rpx;
}
.coach-name {
  font-size: 22rpx;
  font-weight: 900;
  color: #1C1917;
}
.bp-val {
  font-size: 20rpx;
  font-weight: 800;
  font-family: monospace;
}
.bp-track {
  width: 100%;
  height: 10rpx;
  background-color: #F4EFE6;
  border: 2rpx solid #1C1917;
  border-radius: 99rpx;
  overflow: hidden;
  margin-bottom: 8rpx;
}
.bp-fill {
  height: 100%;
  transition: width 0.1s linear;
}
.coach-dialogue {
  font-size: 22rpx;
  font-weight: 800;
  color: #FF5353;
  line-height: 1.3;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 双后视镜视界 */
.mirrors-row {
  gap: 16rpx;
  margin-bottom: 14rpx;
}
.mirror-box {
  flex: 1;
  padding: 12rpx;
  background-color: #FFFFFF;
}
.mirror-tag {
  font-size: 18rpx;
  font-weight: 800;
  color: #78716C;
  margin-bottom: 6rpx;
}
.mirror-glass {
  width: 100%;
  height: 110rpx;
  background-color: #E2E8F0;
  border: 3rpx solid #1C1917;
  border-radius: 12rpx;
  position: relative;
  overflow: hidden;
}
.curb-line-left {
  position: absolute;
  left: 30rpx;
  top: 0;
  bottom: 0;
  width: 8rpx;
  background-color: #FFD23F;
}
.curb-line-right {
  position: absolute;
  right: 30rpx;
  top: 0;
  bottom: 0;
  width: 8rpx;
  background-color: #FFD23F;
}
.wheel-marker {
  width: 28rpx;
  height: 48rpx;
  background-color: #1C1917;
  border-radius: 6rpx;
  position: absolute;
  transition: transform 0.05s linear;
}
.mirror-dist {
  font-size: 18rpx;
  font-weight: 800;
  color: #1C1917;
  margin-top: 6rpx;
  font-family: monospace;
}

/* 考场实景鸟瞰 */
.aerial-bay {
  flex: 1;
  background-color: #2D3748;
  padding: 14rpx;
  position: relative;
  overflow: hidden;
  margin-bottom: 18rpx;
}
.bay-ground {
  width: 100%;
  height: 100%;
  position: relative;
}
.bay-dashed-line {
  position: absolute;
  left: 50%;
  top: 0;
  bottom: 0;
  width: 4rpx;
  border-left: 4rpx dashed #718096;
}
.target-slot {
  position: absolute;
  bottom: 50rpx;
  left: 15%;
  right: 15%;
  height: 170rpx;
  border: 4rpx dashed #FFD23F;
  border-top: none;
  background-color: rgba(255, 210, 63, 0.08);
}
.perfect-core {
  position: absolute;
  bottom: 30rpx;
  left: 10rpx;
  right: 10rpx;
  height: 50rpx;
  background-color: rgba(6, 214, 160, 0.35);
  border: 2rpx solid #06D6A0;
}
.perfect-text {
  font-size: 20rpx;
  font-weight: 900;
  color: #06D6A0;
}
.dead-wall {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 40rpx;
  background-color: #FF5353;
  border-top: 4rpx solid #1C1917;
}
.dead-wall-text {
  font-size: 18rpx;
  font-weight: 900;
  color: #FFFFFF;
}

/* 教练车实体 */
.car-body-entity {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  width: 140rpx;
  transition: top 0.04s linear;
}
.car-chassis {
  width: 110rpx;
  height: 110rpx;
  background-color: #FFFFFF;
  border: 4rpx solid #1C1917;
  border-radius: 18rpx;
  position: relative;
}
.car-icon {
  font-size: 64rpx;
  transform: rotate(180deg);
}
.brake-lamp {
  position: absolute;
  top: 4rpx;
  width: 16rpx;
  height: 10rpx;
  background-color: #718096;
  border-radius: 2rpx;
}
.brake-left { left: 8rpx; }
.brake-right { right: 8rpx; }
.lamp-lit {
  background-color: #FF5353 !important;
  box-shadow: 0 0 16rpx #FF5353;
}
.car-license {
  font-size: 16rpx;
  font-weight: 800;
  background-color: #FFED66;
  border: 2rpx solid #1C1917;
  padding: 2rpx 8rpx;
  border-radius: 4rpx;
  margin-top: 4rpx;
}

/* 操纵按键与结算面板 */
.control-deck {
  width: 100%;
}
.brake-btn-wrap {
  width: 100%;
}
.slam-brake-btn {
  width: 100% !important;
  padding: 30rpx 0 !important;
  font-size: 36rpx;
  background-color: #FF5353 !important;
  color: #FFFFFF !important;
}
.brake-held {
  opacity: 0.6;
}
.pedal-icon {
  margin-right: 12rpx;
}
.result-cockpit {
  width: 100%;
  padding: 18rpx 24rpx;
  background-color: #FFFFFF;
}
.score-number {
  font-size: 52rpx;
  font-weight: 900;
  color: #1C1917;
}
.score-unit {
  font-size: 24rpx;
  font-weight: 700;
}
.score-verdict {
  font-size: 22rpx;
  font-weight: 800;
  color: #FF5353;
  margin-top: 2rpx;
}
.retry-action-btn {
  background-color: #06D6A0 !important;
  color: #1C1917 !important;
  padding: 20rpx 28rpx !important;
  font-size: 26rpx;
}

/* 收益提示通用居中和高质感边框 (正负收益分离配色) */
.reward-success-box, .reward-fail-box {
  font-size: 20rpx;
  font-weight: 900;
  padding: 10rpx 14rpx;
  border-radius: 8rpx;
  border: 2rpx solid #1C1917;
  width: 100%;
  text-align: center;
  display: block;
  box-sizing: border-box;
}
.reward-success-box {
  background-color: #DCFCE7 !important;
  color: #15803D !important;
}
.reward-fail-box {
  background-color: #FEE2E2 !important;
  color: #B91C1C !important;
}

/* 确保各个小游戏结算弹窗中的收益提示文字垂直绝对居中 */
.reward-success-box, .reward-fail-box {
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  text-align: center;
  box-sizing: border-box;
  min-height: 56rpx;
}
.reward-success-box {
  background-color: #DCFCE7 !important;
  color: #15803D !important;
}
.reward-fail-box {
  background-color: #FEE2E2 !important;
  color: #B91C1C !important;
}