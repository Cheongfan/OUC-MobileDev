.sneak-stage {
  height: 100vh;
  padding: 20rpx 28rpx 36rpx;
  background-color: #141518;
  color: #FFFFFF;
  justify-content: space-between;
  transition: background-color 0.15s ease;
  overflow: hidden;
  box-sizing: border-box;
}
.stage-blind {
  background-color: #0A0B0D !important;
}

/* 顶部心率与时钟 HUD */
.monitor-hud {
  padding: 18rpx 22rpx;
  background-color: #1E2025 !important;
  border-color: #383D48 !important;
  color: #FFFFFF !important;
}
.time-digit {
  font-size: 30rpx;
  font-weight: 900;
  font-family: monospace;
  color: #06D6A0;
}
.streak-tag {
  font-size: 18rpx;
  font-weight: 800;
  color: #FFD23F;
  margin-top: 4rpx;
}
.heart-icon {
  font-size: 44rpx;
  margin-right: 12rpx;
}
.heart-bpm {
  font-size: 32rpx;
  font-weight: 900;
  font-family: monospace;
}
.heart-label {
  font-size: 16rpx;
  color: #78716C;
  font-weight: 700;
}

/* 门缝视窗 */
.doorway-zone {
  padding: 16rpx;
  background-color: #1E2025 !important;
  border-color: #383D48 !important;
}
.door-status-pill {
  background-color: #272A30;
  border: 2rpx solid #383D48;
  padding: 6rpx 18rpx;
  border-radius: 99rpx;
  gap: 12rpx;
  margin-bottom: 12rpx;
}
.radar-ping {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background-color: #06D6A0;
}
.danger-ping {
  background-color: #FF5353 !important;
}
.radar-text {
  font-size: 20rpx;
  font-weight: 800;
  color: #E2E8F0;
}
.door-chink-frame {
  width: 260rpx;
  height: 190rpx;
  background-color: #0F1012;
  border: 4rpx solid #383D48;
  border-radius: 12rpx;
  position: relative;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}
.door-slammed {
  border-color: #FF5353 !important;
  box-shadow: 0 0 28rpx rgba(255, 83, 83, 0.6);
}
.light-ray-beam {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  transition: background 0.1s ease;
}
.mom-silhouette {
  font-size: 32rpx;
  font-weight: 900;
  color: #FF5353;
  z-index: 10;
}

/* 手机被窝屏幕 */
.bed-cocoon-view {
  flex: 1;
  justify-content: center;
}
.phone-screen-slab {
  width: 440rpx;
  height: 480rpx;
  background-color: #272A30 !important;
  border-color: #4A5060 !important;
  padding: 30rpx;
  box-shadow: 0 0 30rpx rgba(6, 214, 160, 0.35) !important;
  transition: all 0.15s ease;
}
.screen-off {
  background-color: #121316 !important;
  border-color: #22252B !important;
  box-shadow: none !important;
}
.feed-icon { font-size: 90rpx; }
.feed-title {
  font-size: 22rpx;
  font-weight: 800;
  color: #FFFFFF;
  margin: 14rpx 0 10rpx;
}
.point-ticker {
  font-size: 26rpx;
  font-weight: 900;
  color: #06D6A0;
  font-family: monospace;
}
.blanket-eyes { font-size: 80rpx; }
.blanket-status-text {
  font-size: 20rpx;
  font-weight: 800;
  color: #78716C;
  margin-top: 16rpx;
  text-align: center;
}

/* 操作按键与暴毙面板 */
.sneak-action-deck {
  width: 100%;
}
.sneak-hold-button {
  width: 100% !important;
  padding: 34rpx 0 !important;
  font-size: 34rpx;
  background-color: #06D6A0 !important;
  color: #1C1917 !important;
}
.blanket-active {
  background-color: #FFD23F !important;
  transform: scale(0.97) !important;
}
.captured-hud {
  padding: 24rpx;
  background-color: #272A30 !important;
  border-color: #FF5353 !important;
}
.captured-headline {
  font-size: 32rpx;
  font-weight: 900;
  color: #FF5353;
  margin-bottom: 10rpx;
}
.final-score-val {
  font-size: 28rpx;
  font-weight: 800;
  color: #FFFFFF;
  margin-bottom: 20rpx;
}
.retry-sneak-btn {
  width: 100% !important;
  background-color: #FFD23F !important;
  color: #1C1917 !important;
}

/* 收益提示高质感边框 (负收益红色系) */
.reward-fail-box {
  font-size: 20rpx;
  font-weight: 900;
  padding: 10rpx 14rpx;
  border-radius: 8rpx;
  border: 2rpx solid #1C1917;
  width: 100%;
  text-align: center;
  display: block;
  box-sizing: border-box;
  background-color: #FEE2E2 !important;
  color: #B91C1C !important;
}

/* 确保各个小游戏结算弹窗中的收益提示文字垂直绝对居中 */
.reward-success-box, .reward-fail-box {
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  text-align: center;
  box-sizing: border-box;
  min-height: 56rpx;
}
.reward-success-box {
  background-color: #DCFCE7 !important;
  color: #15803D !important;
}
.reward-fail-box {
  background-color: #FEE2E2 !important;
  color: #B91C1C !important;
}