<view class="sneak-stage flex-column {{ isBlanketCovered ? 'stage-blind' : '' }}">
  <view class="monitor-hud brutal-box flex-between">
    <view class="flex-center" style="gap: 12rpx;">
      <view class="back-home-pill brutal-box brutal-btn-active flex-center" bindtap="onBackClick" style="padding: 6rpx 14rpx; background: #272A30;">
        <text style="font-size: 20rpx; font-weight: 900; color: #FFFFFF;">◀ 返回</text>
      </view>
      <view class="clock-col flex-column">
        <text class="time-digit">03:28:45 AM</text>
        <text class="streak-tag">倍率: x{{ comboRate }}</text>
      </view>
    </view>
    <view class="heart-hud-col flex-center">
      <view class="heart-icon anim-pulse">💓</view>
      <view class="heart-val-col flex-column">
        <text class="heart-bpm" style="{{ bpmColorStyle }}">{{ bpm }} BPM</text>
        <text class="heart-label">被窝心率</text>
      </view>
    </view>
  </view>

  <view class="doorway-zone brutal-box flex-column flex-center">
    <view class="door-status-pill flex-between">
      <text class="radar-ping {{ alertState === 2 ? 'danger-ping' : '' }}"></text>
      <text class="radar-text">{{ radarStateText }}</text>
    </view>
    <view class="door-chink-frame {{ alertState === 2 ? 'door-slammed' : '' }}">
      <view class="light-ray-beam" style="{{ doorLightStyle }}"></view>
      <text class="mom-silhouette" wx:if="{{ alertState === 2 }}">👵 “还没睡?！”</text>
    </view>
  </view>

  <view class="bed-cocoon-view flex-center flex-column">
    <view class="phone-screen-slab brutal-box flex-column flex-center {{ isBlanketCovered ? 'screen-off' : '' }}">
      <block wx:if="{{ !isBlanketCovered }}">
        <text class="feed-icon">📱</text>
        <text class="feed-title">深夜短视频极速冲浪中</text>
        <div class="point-ticker">+{{ 10 * comboRate }} pt / 0.5s</div>
      </block>
      <block wx:else>
        <text class="blanket-eyes">👀</text>
        <text class="blanket-status-text">【蒙头装死中】呼噜声已开到最大...</text>
      </block>
    </view>
  </view>

  <view class="sneak-action-deck">
    <button 
      class="brutal-btn sneak-hold-button {{ isBlanketCovered ? 'blanket-active' : '' }}" 
      bindtouchstart="startBlanketHold" 
      bindtouchend="releaseBlanketHold" 
      wx:if="{{ !isCaptured }}">
      🛌 长按将被子蒙过头顶装睡！
    </button>

    <view class="captured-hud brutal-box flex-column flex-center" wx:if="{{ isCaptured }}">
      <text class="captured-headline">🚨 人赃并获！手机已被没收！</text>
      <text class="final-score-val">潜行冲浪总分: {{ totalScore }} 分</text>
      
      <!-- 收益总结框 -->
      <view class="reward-fail-box" style="margin-bottom: 14rpx; width: 100%; text-align: center;">
        {{ rewardSummary }}
      </view>

      <!-- 动态按钮：如果来自主线，显示确认战果并返回；如果来自街机厅，显示再熬一晚 -->
      <button class="brutal-btn retry-sneak-btn" bindtap="confirmAndReturn">
        {{ fromMain ? '🏆 确认战果并返回主线' : '🌙 再熬一晚 (重新挑战)' }}
      </button>
    </view>
  </view>
</view>