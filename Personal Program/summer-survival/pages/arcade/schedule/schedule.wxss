.schedule-viewport {
  height: 100vh;
  padding: 18rpx 24rpx 28rpx;
  background-color: #FDFBF7;
  justify-content: space-between;
  overflow: hidden;
  box-sizing: border-box;
}

/* 顶部 HUD */
.score-hud {
  padding: 14rpx 20rpx;
  background-color: #FFFFFF;
}
.score-label {
  font-size: 18rpx;
  font-weight: 700;
  color: #78716C;
}
.score-digits {
  font-size: 40rpx;
  font-weight: 900;
  font-family: monospace;
  color: #1C1917;
  line-height: 1.1;
}

.combo-pill {
  background-color: #F4EFE6;
  border: 2rpx solid #1C1917;
  border-radius: 99rpx;
  padding: 6rpx 16rpx;
  gap: 6rpx;
}
.combo-fire {
  background-color: #FFED66 !important;
  box-shadow: 2rpx 2rpx 0rpx #1C1917;
}
.combo-icon { font-size: 20rpx; }
.combo-text {
  font-size: 20rpx;
  font-weight: 900;
}

.sanity-col {
  width: 120rpx;
}
.sanity-percent {
  font-size: 24rpx;
  font-weight: 900;
  color: #06D6A0;
  font-family: monospace;
}
.sanity-name {
  font-size: 16rpx;
  color: #78716C;
  font-weight: 700;
}
.sanity-track {
  width: 100%;
  height: 8rpx;
  background-color: #F4EFE6;
  border: 1rpx solid #1C1917;
  border-radius: 99rpx;
  overflow: hidden;
  margin-top: 4rpx;
}
.sanity-fill {
  height: 100%;
  transition: width 0.2s ease;
}

/* 状态横幅 */
.routine-banner {
  padding: 10rpx 18rpx;
  background-color: #FFFFFF;
  margin: 10rpx 0;
}
.banner-left { gap: 10rpx; }
.banner-emoji { font-size: 26rpx; }
.banner-msg {
  font-size: 20rpx;
  font-weight: 800;
  color: #1C1917;
}
.line-cleared-tag {
  font-size: 18rpx;
  font-weight: 800;
  color: #78716C;
}

/* 6x6 矩阵棋盘 */
.clock-matrix-stage {
  flex: 1;
  align-items: center;
  justify-content: center;
}
.board-casing {
  width: 600rpx;
  height: 600rpx;
  background-color: #EDE8DF;
  border-width: 5rpx !important;
  padding: 16rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.time-header-row {
  padding: 0 4rpx 8rpx;
}
.th-label {
  font-size: 16rpx;
  font-family: monospace;
  font-weight: 800;
  color: #78716C;
}

.grid-board {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  background-color: #D6D0C4;
  border: 3rpx solid #1C1917;
  border-radius: 12rpx;
  padding: 8rpx;
}
.grid-row {
  flex: 1;
  gap: 8rpx;
  margin-bottom: 8rpx;
}
.grid-row:last-child { margin-bottom: 0; }

.grid-cell {
  flex: 1;
  height: 100%;
  background-color: #FAF8F5;
  border: 2rpx solid #B8B0A2;
  border-radius: 8rpx;
  position: relative;
  transition: background-color 0.12s ease;
}
.cell-preview {
  background-color: #FEFCBF !important;
  border-color: #D69E2E !important;
}
.cell-occupied {
  border-color: #1C1917 !important;
}
.cell-icon {
  font-size: 38rpx;
}

/* 活动色彩映射 */
.cell-sleep { background-color: #BEE3F8 !important; }
.cell-phone { background-color: #D6BCFA !important; }
.cell-study { background-color: #9AE6B4 !important; }
.cell-game { background-color: #FEB2B2 !important; }
.cell-chores { background-color: #FAF089 !important; }
.cell-feast { background-color: #FBD38D !important; }

/* 底部候选活动槽 */
.dock-selection-area {
  background-color: #FFFFFF;
  padding: 14rpx 18rpx;
  margin-bottom: 12rpx;
}
.dock-header {
  margin-bottom: 10rpx;
}
.dock-title {
  font-size: 20rpx;
  font-weight: 900;
  color: #1C1917;
}
.dock-tip {
  font-size: 16rpx;
  color: #A8A29E;
}

.dock-slots-row {
  gap: 16rpx;
}
.slot-card {
  flex: 1;
  height: 150rpx;
  background-color: #FDFBF7;
  padding: 8rpx;
  justify-content: center;
  position: relative;
}
.slot-active {
  border-color: #FF5353 !important;
  background-color: #FFF5F5 !important;
  transform: translateY(-4rpx);
}
.slot-empty {
  opacity: 0.25;
  filter: grayscale(1);
  pointer-events: none;
}
.slot-emoji { font-size: 34rpx; }
.slot-name {
  font-size: 18rpx;
  font-weight: 800;
  margin: 2rpx 0 6rpx;
  color: #1C1917;
}

/* 微缩形状小点阵 */
.mini-shape-grid {
  gap: 4rpx;
}
.mini-row { gap: 4rpx; }
.mini-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 3rpx;
  border: 1rpx solid #1C1917;
}
.dot-off {
  background-color: transparent;
  border-color: transparent;
}
.dot-sleep { background-color: #BEE3F8; }
.dot-phone { background-color: #D6BCFA; }
.dot-study { background-color: #9AE6B4; }
.dot-game { background-color: #FEB2B2; }
.dot-chores { background-color: #FAF089; }
.dot-feast { background-color: #FBD38D; }

.empty-text {
  font-size: 20rpx;
  color: #A8A29E;
  font-weight: 700;
}

.action-footer {
  width: 100%;
}
.restart-btn, .submit-day-btn {
  width: 100% !important;
  padding: 20rpx 0 !important;
  font-size: 24rpx;
}
.restart-btn { background-color: #F4EFE6 !important; }

/* 结算弹窗 */
.collapse-modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(20, 21, 24, 0.75);
  z-index: 1000;
  padding: 40rpx;
}
.collapse-dialog {
  width: 100%;
  padding: 36rpx 28rpx;
  background-color: #FFFFFF;
  text-align: center;
}
.collapse-title {
  font-size: 36rpx;
  font-weight: 900;
  color: #FF5353;
}
.collapse-icon-box {
  width: 130rpx;
  height: 130rpx;
  background-color: #FEEBC8;
  border: 3rpx solid #1C1917;
  border-radius: 24rpx;
  margin: 16rpx 0;
}
.collapse-emoji { font-size: 72rpx; }
.collapse-verdict {
  font-size: 22rpx;
  line-height: 1.5;
  color: #4A5568;
  font-weight: 700;
  margin-bottom: 24rpx;
}
.collapse-stats-box {
  width: 100%;
  background-color: #F7FAFC;
  border: 2rpx solid #E2E8F0;
  border-radius: 12rpx;
  padding: 16rpx 10rpx;
  margin-bottom: 24rpx;
}
.st-cell { flex: 1; }
.st-val {
  font-size: 32rpx;
  font-weight: 900;
  color: #1C1917;
  font-family: monospace;
}
.st-lbl {
  font-size: 16rpx;
  color: #78716C;
  font-weight: 700;
  margin-top: 2rpx;
}
.modal-play-again-btn {
  width: 100% !important;
  font-size: 28rpx;
}

/* 收益提示通用居中样式 */
.reward-success-box {
  font-size: 20rpx;
  font-weight: 900;
  padding: 10rpx 14rpx;
  border-radius: 8rpx;
  border: 2rpx solid #1C1917;
  width: 100%;
  text-align: center;
  display: block;
  box-sizing: border-box;
  background-color: #DCFCE7 !important;
  color: #15803D !important;
}

/* 确保各个小游戏结算弹窗中的收益提示文字垂直绝对居中 */
.reward-success-box, .reward-fail-box {
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  text-align: center;
  box-sizing: border-box;
  min-height: 56rpx;
}
.reward-success-box {
  background-color: #DCFCE7 !important;
  color: #15803D !important;
}
.reward-fail-box {
  background-color: #FEE2E2 !important;
  color: #B91C1C !important;
}