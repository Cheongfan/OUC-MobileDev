.pack-container {
  height: 100vh;
  padding: 18rpx 24rpx 28rpx;
  background-color: #FDFBF7;
  justify-content: space-between;
  overflow: hidden;
  box-sizing: border-box;
}

/* 顶部关卡 HUD */
.mission-hud {
  padding: 14rpx 20rpx;
  background-color: #FFFFFF;
}
.mission-badge {
  gap: 12rpx;
  margin-bottom: 6rpx;
}
.level-num {
  font-size: 18rpx;
  font-weight: 900;
  background-color: #FF5353;
  color: #FFFFFF;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
}
.level-title {
  font-size: 26rpx;
  font-weight: 900;
  color: #1C1917;
}
.mission-condition {
  font-size: 18rpx;
  color: #78716C;
  font-weight: 700;
}

.density-gauge {
  width: 140rpx;
}
.density-val {
  font-size: 30rpx;
  font-weight: 900;
  font-family: monospace;
  color: #06D6A0;
}
.density-label {
  font-size: 16rpx;
  font-weight: 700;
  color: #78716C;
  margin-bottom: 4rpx;
}
.density-track {
  width: 100%;
  height: 10rpx;
  background-color: #F4EFE6;
  border: 2rpx solid #1C1917;
  border-radius: 99rpx;
  overflow: hidden;
}
.density-fill {
  height: 100%;
  transition: width 0.2s ease;
}

/* 羁绊/警报提示横幅 */
.hazard-banner {
  padding: 10rpx 18rpx;
  background-color: #FFFFFF;
  margin: 10rpx 0;
}
.hazard-active {
  background-color: #FFF5F5 !important;
  border-color: #FF5353 !important;
}
.hazard-left { gap: 10rpx; }
.hazard-icon { font-size: 24rpx; }
.hazard-text {
  font-size: 20rpx;
  font-weight: 800;
  color: #1C1917;
}
.hazard-score { text-align: right; }
.hz-score-num {
  font-size: 22rpx;
  font-weight: 900;
  color: #FF5353;
}
.hz-score-lbl {
  font-size: 14rpx;
  color: #78716C;
  font-weight: 700;
}

/* 行李箱实体 */
.trunk-stage {
  flex: 1;
  position: relative;
  align-items: center;
  justify-content: center;
  padding: 6rpx 0;
}
.trunk-casing {
  width: 540rpx;
  height: 540rpx;
  background-color: #E2E8F0;
  border-width: 6rpx !important;
  padding: 24rpx;
  position: relative;
  box-shadow: 10rpx 10rpx 0rpx #1C1917 !important;
}

/* 金属包角防撞装饰 */
.corner-lock {
  position: absolute;
  width: 24rpx;
  height: 24rpx;
  background-color: #FFD23F;
  border: 3rpx solid #1C1917;
}
.lock-tl { top: -6rpx; left: -6rpx; }
.lock-tr { top: -6rpx; right: -6rpx; }
.lock-bl { bottom: -6rpx; left: -6rpx; }
.lock-br { bottom: -6rpx; right: -6rpx; }
.trunk-handle {
  position: absolute;
  top: -24rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 140rpx;
  height: 22rpx;
  background-color: #1C1917;
  border-radius: 8rpx 8rpx 0 0;
}

/* 5x5 矩阵网格 */
.grid-matrix {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  background-color: #CBD5E0;
  padding: 8rpx;
  border: 3rpx solid #1C1917;
  border-radius: 12rpx;
}
.matrix-row {
  flex: 1;
  gap: 8rpx;
  margin-bottom: 8rpx;
}
.matrix-row:last-child { margin-bottom: 0; }
.matrix-cell {
  flex: 1;
  height: 100%;
  background-color: #F8FAFC;
  border: 2rpx solid #94A3B8;
  border-radius: 8rpx;
  position: relative;
  transition: all 0.1s ease;
}
.cell-hovered {
  background-color: #FEFCBF !important;
  border-color: #D69E2E !important;
  box-shadow: inset 0 0 10rpx rgba(214, 158, 46, 0.5);
}
.cell-filled {
  border-color: #1C1917 !important;
}
.cell-emoji {
  font-size: 42rpx;
  z-index: 5;
}
.cell-block-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background-color: rgba(28, 25, 23, 0.3);
}

/* 物品不同色块标识 */
.cell-color-watermelon { background-color: #9AE6B4 !important; }
.cell-color-power { background-color: #FBD38D !important; }
.cell-color-spray { background-color: #90CDF4 !important; }
.cell-color-laptop { background-color: #E9D8FD !important; }
.cell-color-pickles { background-color: #FEB2B2 !important; }
.cell-color-book { background-color: #FAF089 !important; }
.cell-color-umbrella { background-color: #81E6D9 !important; }

/* 选中物品操作条 */
.control-pod {
  padding: 12rpx 18rpx;
  background-color: #FFFFFF;
  margin-bottom: 10rpx;
}
.selected-meta { gap: 14rpx; }
.selected-icon-bubble {
  width: 64rpx;
  height: 64rpx;
  background-color: #FEFCBF;
  border: 3rpx solid #1C1917;
  border-radius: 14rpx;
}
.sel-emoji { font-size: 38rpx; }
.sel-name {
  font-size: 24rpx;
  font-weight: 900;
  color: #1C1917;
}
.sel-trait {
  font-size: 18rpx;
  color: #78716C;
  font-weight: 700;
}
.pod-actions { gap: 14rpx; }
.rotate-btn {
  padding: 12rpx 20rpx !important;
  font-size: 22rpx;
  background-color: #06D6A0 !important;
}
.cancel-btn {
  width: 54rpx;
  height: 54rpx;
  border-radius: 12rpx;
  background-color: #F4EFE6;
  font-size: 24rpx;
  font-weight: 900;
}

/* 修复传送带高度塌陷与 flex 压缩问题 */
.conveyor-belt-section {
  background-color: #FFFFFF;
  border: 3rpx solid #1C1917;
  border-radius: 16rpx;
  padding: 12rpx 14rpx;
  margin-bottom: 12rpx;
  flex-shrink: 0;
}
.conveyor-title-row {
  margin-bottom: 10rpx;
}
.conveyor-title {
  font-size: 20rpx;
  font-weight: 900;
  color: #1C1917;
}
.conveyor-hint {
  font-size: 16rpx;
  color: #A8A29E;
}
.conveyor-scroll {
  width: 100%;
  height: 145rpx;
  white-space: nowrap;
  display: flex;
}
.item-card {
  display: inline-flex;
  width: 130rpx;
  height: 130rpx;
  flex-shrink: 0;
  padding: 6rpx;
  background-color: #FDFBF7;
  position: relative;
  justify-content: center;
  margin-right: 14rpx;
}
.item-selected {
  border-color: #FF5353 !important;
  background-color: #FFF5F5 !important;
  transform: translateY(-4rpx);
}
.item-packed {
  opacity: 0.3;
  filter: grayscale(1);
  pointer-events: none;
}
.card-emoji { font-size: 42rpx; }
.card-name {
  font-size: 18rpx;
  font-weight: 800;
  margin: 4rpx 0 2rpx;
  color: #1C1917;
}
.dim-tag {
  font-size: 16rpx;
  color: #78716C;
  font-family: monospace;
  font-weight: 800;
}

/* 底部操作 */
.action-footer { gap: 16rpx; }
.clear-btn {
  flex: 1;
  padding: 22rpx 0 !important;
  font-size: 24rpx;
  background-color: #F4EFE6 !important;
}
.submit-btn {
  flex: 2;
  padding: 22rpx 0 !important;
  font-size: 28rpx;
}

/* 全满高亮与未满置灰 */
.btn-ready-highlight {
  background-color: #06D6A0 !important;
  box-shadow: 4rpx 4rpx 0rpx #1C1917 !important;
  animation: neonGlow 1.5s infinite ease-in-out;
}
.btn-dimmed {
  background-color: #E2E8F0 !important;
  color: #718096 !important;
}

/* 安检结算弹窗 */
.inspect-modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(20, 21, 24, 0.75);
  z-index: 1000;
  padding: 30rpx;
}
.inspect-dialog {
  width: 100%;
  padding: 30rpx;
  background-color: #FFFFFF;
}
.dialog-title {
  font-size: 26rpx;
  font-weight: 900;
}
.xray-screen {
  background-color: #1A202C;
  border: 4rpx solid #1C1917;
  border-radius: 14rpx;
  padding: 24rpx;
  margin: 18rpx 0;
}
.xray-emoji { font-size: 72rpx; }
.xray-verdict {
  font-size: 28rpx;
  font-weight: 900;
  color: #06D6A0;
  margin-top: 10rpx;
}
.inspect-log-box {
  background-color: #F8FAFC;
  border-left: 6rpx solid #1C1917;
  padding: 14rpx;
  margin-bottom: 20rpx;
  gap: 8rpx;
}
.log-line {
  font-size: 20rpx;
  color: #4A5568;
  font-weight: 700;
}
.log-danger { color: #E53E3E !important; font-weight: 900; }
.log-bonus { color: #38A169 !important; font-weight: 900; }

.dialog-score-row {
  margin-bottom: 24rpx;
}
.dlg-score-lbl {
  font-size: 24rpx;
  font-weight: 900;
  color: #78716C;
}
.dlg-score-val {
  font-size: 44rpx;
  font-weight: 900;
  color: #FF5353;
  font-family: monospace;
}
.dialog-btn-row { gap: 16rpx; }
.modal-btn-retry {
  flex: 1;
  padding: 18rpx 0 !important;
  font-size: 24rpx;
  background-color: #F4EFE6 !important;
}
.modal-btn-next {
  flex: 1;
  padding: 18rpx 0 !important;
  font-size: 24rpx;
  background-color: #06D6A0 !important;
}

/* 收益提示通用居中和高质感边框 */
.reward-success-box, .reward-fail-box {
  font-size: 20rpx;
  font-weight: 900;
  padding: 10rpx 14rpx;
  border-radius: 8rpx;
  border: 2rpx solid #1C1917;
  width: 100%;
  text-align: center;
  display: block;
  box-sizing: border-box;
}
.reward-success-box {
  background-color: #DCFCE7 !important;
  color: #15803D !important;
}
.reward-fail-box {
  background-color: #FEE2E2 !important;
  color: #B91C1C !important;
}

/* 确保各个小游戏结算弹窗中的收益提示文字垂直绝对居中 */
.reward-success-box, .reward-fail-box {
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  text-align: center;
  box-sizing: border-box;
  min-height: 56rpx;
}
.reward-success-box {
  background-color: #DCFCE7 !important;
  color: #15803D !important;
}
.reward-fail-box {
  background-color: #FEE2E2 !important;
  color: #B91C1C !important;
}