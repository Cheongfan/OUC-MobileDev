/* pages/ranking/ranking.wxss */
.rank-container {
  padding: 24rpx 32rpx 160rpx;
  background-color: #FDFBF7;
  min-height: 100vh;
}

.rank-hero {
  padding: 30rpx 28rpx 24rpx;
  margin-bottom: 30rpx;
  background-color: #FFFFFF;
}
.hero-top {
  margin-bottom: 12rpx;
}
.hero-time {
  font-size: 20rpx;
  color: #78716C;
  font-weight: 700;
}
.hero-title {
  font-size: 48rpx;
  font-weight: 900;
  margin-bottom: 8rpx;
  color: #1C1917;
}
.hero-desc {
  font-size: 22rpx;
  color: #78716C;
  line-height: 1.5;
  display: block;
  margin-bottom: 24rpx;
}

/* 标签切换：确保完美的水平滚动与居中对齐 */
.tab-control-wrap {
  width: 100%;
}
.tab-scroll {
  white-space: nowrap;
  display: flex;
  gap: 14rpx;
}
.tab-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center; /* 🌟 核心：确保文本绝对居中对齐 */
  padding: 14rpx 28rpx;
  font-size: 22rpx;
  font-weight: 900;
  border: 3rpx solid #1C1917;
  border-radius: 99rpx;
  background-color: #F4EFE6;
  color: #1C1917;
  margin-right: 14rpx;
  transition: all 0.15s ease;
  box-sizing: border-box;
}
.tab-btn.active {
  background-color: #FFD23F;
  box-shadow: 3rpx 3rpx 0rpx #1C1917;
}

/* 排行榜单项 */
.rank-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.rank-card {
  padding: 22rpx 20rpx;
  background-color: #FFFFFF;
  align-items: center;
}
.top-three {
  border-width: 5rpx !important;
}

.rank-num-wrap {
  width: 60rpx;
  font-size: 36rpx;
  font-weight: 900;
}

.player-info {
  flex: 1;
  padding: 0 18rpx;
}
.player-header {
  margin-bottom: 6rpx;
}
.player-name {
  font-size: 28rpx;
  font-weight: 900;
}
.brutal-badge-mini {
  font-size: 18rpx;
  font-weight: 800;
  background-color: #F4EFE6;
  border: 2rpx solid #1C1917;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
}
.player-motto {
  font-size: 20rpx;
  color: #78716C;
  font-style: italic;
}

.score-box {
  text-align: right;
  min-width: 100rpx;
}
.score-val {
  font-size: 36rpx;
  font-weight: 900;
  color: #FF5353;
}
.score-unit {
  font-size: 18rpx;
  font-weight: 700;
  color: #78716C;
}

.self-card {
  background-color: #FFFDF0 !important;
  border-color: #FF5353 !important;
}

.my-rank-fixed {
  position: fixed;
  bottom: 24rpx;
  left: 32rpx;
  right: 32rpx;
  background-color: #1C1917;
  color: #FFFFFF;
  border-color: #FFED66;
  padding: 20rpx 24rpx;
  box-shadow: 6rpx 6rpx 0rpx #FF5353;
  z-index: 100;
}
.my-avatar {
  font-size: 40rpx;
  margin-right: 16rpx;
}
.my-title {
  font-size: 24rpx;
  font-weight: 900;
}
.my-status {
  font-size: 18rpx;
  color: #06D6A0;
  margin-top: 4rpx;
}
.my-score-col {
  text-align: right;
}
.my-val {
  font-size: 36rpx;
  font-weight: 900;
  color: #FFED66;
}
.my-unit { font-size: 20rpx; }
.my-pos {
  font-size: 18rpx;
  color: #A8A29E;
}