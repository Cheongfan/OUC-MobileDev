.settings-container {
  padding: 24rpx 28rpx 70rpx;
  background-color: #FDFBF7;
  min-height: 100vh;
  box-sizing: border-box;
}

.header-section {
  margin-bottom: 24rpx;
}
.text-title-large {
  font-size: 32rpx;
  font-weight: 900;
  color: #1C1917;
}
.text-caption {
  font-size: 20rpx;
  color: #78716C;
  margin-top: 6rpx;
}

.setting-group {
  margin-bottom: 24rpx;
  background-color: #FFFFFF;
  padding: 22rpx 24rpx;
}

.group-ai-border {
  border-left: 12rpx solid #2563EB !important;
}

.group-title {
  font-size: 24rpx;
  font-weight: 900;
  border-bottom: 2rpx dashed #E7E5E4;
  padding-bottom: 14rpx;
  margin-bottom: 10rpx;
  color: #1C1917;
}
.group-sub-tag {
  font-size: 18rpx;
  font-weight: 800;
  color: #78716C;
  background-color: #F4EFE6;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
}

.ai-title-icon {
  font-size: 28rpx;
  margin-right: 8rpx;
}

.setting-row {
  padding: 18rpx 0;
  border-bottom: 2rpx dashed #F5F5F4;
}
.setting-row:last-child {
  border-bottom: none;
}

.row-info {
  flex: 1;
  padding-right: 20rpx;
}
.row-label {
  font-size: 24rpx;
  font-weight: 800;
  color: #1C1917;
}
.row-desc {
  font-size: 18rpx;
  color: #78716C;
  margin-top: 4rpx;
}

/* 震动强度标签 */
.intensity-group {
  display: flex;
  gap: 10rpx;
}
.intensity-tag {
  font-size: 20rpx;
  font-weight: 800;
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
  background-color: #F4EFE6;
}
.intensity-tag.active {
  background-color: #FFED66 !important;
}

/* AI 监控指标面板 */
.status-indicator-pill {
  padding: 4rpx 12rpx;
  background-color: #F4EFE6;
  border-radius: 99rpx;
  border: 2rpx solid #1C1917;
  gap: 8rpx;
}
.pulse-indicator-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
}
.dot-online {
  background-color: #06D6A0;
  animation: pulseDot 0.8s infinite;
}
.dot-offline {
  background-color: #FF5353;
}
.indicator-text {
  font-size: 16rpx;
  font-weight: 900;
}
@keyframes pulseDot {
  0%, 100% { transform: scale(1); opacity: 1; }
  50% { transform: scale(1.3); opacity: 0.6; }
}

.metrics-grid {
  gap: 12rpx;
  margin: 14rpx 0 16rpx;
}
.metric-cell {
  flex: 1;
  padding: 14rpx 6rpx;
  background-color: #FDFBF7;
}
.metric-num {
  font-size: 30rpx;
  font-weight: 900;
  font-family: monospace;
  color: #2563EB;
}
.metric-name {
  font-size: 16rpx;
  font-weight: 800;
  color: #78716C;
  margin-top: 2rpx;
}

/* 中继地址与 Ping 按钮 */
.proxy-config-group {
  margin-top: 8rpx;
}
.proxy-title-row {
  margin-bottom: 8rpx;
}
.proxy-label {
  font-size: 18rpx;
  font-weight: 800;
  color: #1C1917;
}
.ping-badge {
  font-size: 18rpx;
  font-weight: 900;
  font-family: monospace;
  color: #06D6A0;
}
.proxy-input-row {
  gap: 10rpx;
}
.proxy-input {
  flex: 1;
  height: 64rpx;
  padding: 0 16rpx;
  font-size: 20rpx;
  background-color: #FAFAFA;
}
.ping-btn {
  padding: 0 20rpx;
  height: 64rpx;
  background-color: #FFD23F;
}
.ping-btn-txt {
  font-size: 18rpx;
  font-weight: 900;
  color: #1C1917;
}
.proxy-hint {
  font-size: 16rpx;
  color: #78716C;
  margin-top: 8rpx;
  line-height: 1.3;
}

/* 规范说明卡片 */
.spec-note-box {
  background-color: #1C1917;
  color: #FDFBF7;
  padding: 16rpx 18rpx;
  border-radius: 12rpx;
  margin-top: 16rpx;
}
.spec-header {
  margin-bottom: 6rpx;
}
.spec-title {
  font-size: 18rpx;
  font-weight: 900;
  color: #FFD23F;
}
.spec-tag {
  font-size: 16rpx;
  font-family: monospace;
  background-color: #374151;
  padding: 2rpx 6rpx;
  border-radius: 4rpx;
}
.spec-item {
  display: block;
  font-size: 16rpx;
  line-height: 1.5;
  color: #D6D3D1;
}

/* 危险按钮实体：杜绝原生 button */
.danger-btn {
  padding: 12rpx 22rpx;
  background-color: #FFE4E6;
  border-radius: 12rpx;
}
.danger-btn-text {
  font-size: 20rpx;
  font-weight: 900;
  color: #FF5353;
}

/* 底部版本与彩蛋 */
.version-section {
  margin-top: 36rpx;
  text-align: center;
}
.version-text {
  font-size: 20rpx;
  font-weight: 800;
  color: #78716C;
}
.version-sub {
  font-size: 16rpx;
  color: #A8A29E;
  margin-top: 4rpx;
}
.debug-hint {
  font-size: 18rpx;
  color: #FF5353;
  font-weight: 800;
  margin-top: 8rpx;
}

.cloud-service-badge {
  flex: 1;
  height: 64rpx;
  padding: 0 16rpx;
  background-color: #F4EFE6;
  align-items: center;
}
.cloud-icon { font-size: 24rpx; }
.cloud-name { font-size: 20rpx; font-weight: 900; font-family: monospace; color: #1C1917; }
.cloud-status-tag { font-size: 16rpx; font-weight: 800; color: #06D6A0; background-color: #1C1917; padding: 2rpx 8rpx; border-radius: 6rpx; }