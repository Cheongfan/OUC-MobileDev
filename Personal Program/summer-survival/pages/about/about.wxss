/* pages/about/about.wxss */
.about-container {
  padding: 30rpx 36rpx 80rpx;
  background-color: #FFFDF7;
  min-height: 100vh;
}

/* 仿工卡顶部挂绳结构 */
.lanyard-hole {
  margin-bottom: -18rpx;
  z-index: 2;
  position: relative;
}
.hole-pill {
  width: 140rpx;
  height: 28rpx;
  background-color: #1E1E1E;
  border-radius: 99rpx;
  border: 4rpx solid #FFFFFF;
}

.badge-card {
  position: relative;
  background: #FFFFFF;
  margin-bottom: 36rpx;
}

.badge-header {
  border-bottom: 3rpx dashed #E0E0E0;
  padding-bottom: 18rpx;
  margin-bottom: 24rpx;
}
.badge-brand {
  font-size: 24rpx;
  font-weight: 900;
  letter-spacing: 2rpx;
  color: #1E1E1E;
}

.profile-section {
  align-items: center;
  margin-bottom: 28rpx;
}
.avatar-wrap {
  width: 130rpx;
  height: 130rpx;
  border-radius: 20rpx;
  background-color: #FFED66;
  border: 4rpx solid #1E1E1E;
  box-shadow: 4rpx 4rpx 0rpx #1E1E1E;
  display: flex;
  align-items: center;
  justify-content: center;
}
.avatar-emoji {
  font-size: 72rpx;
}
.profile-info {
  flex: 1;
  margin-left: 28rpx;
}
.student-name {
  font-size: 38rpx;
  font-weight: 900;
}
.student-title {
  font-size: 24rpx;
  color: #FF5E5B;
  font-weight: 800;
  margin-top: 4rpx;
}
.student-dept {
  font-size: 22rpx;
  color: #888888;
  margin-top: 4rpx;
}

.memo-box {
  background-color: #F8F9FA;
  border-radius: 16rpx;
  padding: 20rpx;
  border-left: 8rpx solid #00CECB;
  margin-bottom: 28rpx;
}
.memo-title {
  font-size: 24rpx;
  font-weight: 800;
  margin-bottom: 8rpx;
}
.memo-content {
  font-size: 24rpx;
  line-height: 1.6;
  color: #555555;
}

.tech-stack-title {
  font-size: 24rpx;
  font-weight: 800;
  margin-bottom: 14rpx;
}
.tech-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 28rpx;
}
.tag-item {
  font-size: 20rpx;
  font-weight: 700;
  background-color: #F0F0F0;
  border: 2rpx solid #1E1E1E;
  border-radius: 8rpx;
  padding: 6rpx 14rpx;
}

/* 链接卡片组容器：纵向排布，两项完美对齐 */
.link-cards-col {
  gap: 16rpx;
}
.repo-box {
  background-color: #FFF9E6;
  border: 3rpx solid #1E1E1E;
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.repo-info {
  flex: 1;
  padding-right: 16rpx;
  overflow: hidden;
}
.repo-label {
  font-size: 20rpx;
  color: #888888;
  font-weight: 700;
}
.repo-url {
  font-size: 21rpx;
  font-family: monospace;
  font-weight: 800;
  color: #1E1E1E;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-top: 4rpx;
}

/* 统一对齐的复制按钮样式 */
.copy-btn {
  width: 140rpx;
  height: 60rpx;
  background-color: #06D6A0;
  border: 3rpx solid #1E1E1E;
  border-radius: 12rpx;
  box-shadow: 2rpx 2rpx 0rpx #1E1E1E;
  flex-shrink: 0;
}
.copy-btn-txt {
  font-size: 24rpx;
  font-weight: 900;
  color: #1E1E1E;
}

.letter-card {
  background-color: #FFFFFF;
}
.letter-title {
  font-size: 28rpx;
  font-weight: 800;
  margin-bottom: 14rpx;
}
.letter-text {
  font-size: 24rpx;
  line-height: 1.7;
  color: #555555;
  margin-bottom: 20rpx;
}
.letter-sign {
  border-top: 2rpx solid #EEEEEE;
  padding-top: 14rpx;
  font-size: 22rpx;
  color: #999999;
}
.egg-hint {
  color: #8E7DBE;
  font-weight: 700;
}