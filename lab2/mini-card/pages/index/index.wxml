<view class="container">
  <!-- 1. AI 16:9 头图 -->
  <image class="header-bg" src="/images/1.png" mode="aspectFill"></image>

  <!-- 2. 悬浮个人信息卡片 -->
  <view class="profile-card">
    <image class="avatar" src="/images/2.png" mode="aspectFill"></image>
    <view class="name">吴啸天</view>
    <view class="title">中国海洋大学 · 移动软件开发学习者</view>
    
    <!-- 标签云 -->
    <view class="tags">
      <text class="tag">微信小程序</text>
      <text class="tag">人工智能</text>
      <text class="tag">VR</text>
      <text class="tag">OUCers</text>
    </view>
  </view>

  <!-- 3. 简介区 -->
  <view class="section">
    <view class="section-title">个人简介</view>
    <view class="section-content">
      正在学习移动软件开发与前端技术
    </view>
    <view class="section-content">
      科研方向为VR与人机交互，偏深度学习领域
    </view>
    <view class="section-content">
      致力于用技术解决实际问题，欢迎交流合作！
    </view>
  </view>

  <!-- 4. 联系方式 & 交互区 -->
  <view class="section">
    <view class="section-title">联系方式</view>
    <view class="info-item" bindtap="copyEmail">
      <text class="label">邮箱：</text>
      <text class="value">wuxiaotian@stu.ouc.edu.cn (点击复制)</text>
    </view>
    <view class="info-item" bindtap="openLocation">
      <text class="label">地址：</text>
      <text class="value">中国海洋大学西海岸校区听海苑3楼 (点击定位)</text>
    </view>
  </view>

  <!-- 5. 底部操作按钮 -->
  <view class="btn-group">
    <button class="btn btn-primary" bindtap="saveContact">保存到通讯录</button>
    <button class="btn btn-secondary" open-type="share">分享名片</button>
  </view>
</view>