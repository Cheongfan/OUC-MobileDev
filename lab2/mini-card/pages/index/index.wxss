page {
  background-color: #f5f7fa;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
}

.header-bg {
  width: 100%;
  height: 420rpx; /* 16:9 */
}

.profile-card {
  background: #ffffff;
  margin: -80rpx 30rpx 20rpx 30rpx;
  border-radius: 20rpx;
  padding: 40rpx 30rpx 30rpx 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 10rpx 30rpx rgba(0,0,0,0.08);
  position: relative;
}

.avatar {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  border: 6rpx solid #ffffff;
  margin-top: -90rpx;
  box-shadow: 0 4rpx 15rpx rgba(0,0,0,0.15);
}

.name {
  font-size: 40rpx;
  font-weight: bold;
  color: #1e293b;
  margin-top: 15rpx;
}

.title {
  font-size: 24rpx;
  color: #64748b;
  margin-top: 8rpx;
}

.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 20rpx;
}

.tag {
  background: #e0f2fe;
  color: #0284c7;
  font-size: 22rpx;
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
}

.section {
  background: #ffffff;
  margin: 0 30rpx 30rpx 30rpx;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 15rpx rgba(0,0,0,0.03);
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #0f172a;
  margin-bottom: 15rpx;
}

.section-content {
  font-size: 26rpx;
  color: #475569;
  line-height: 1.6;
}

.info-item {
  font-size: 26rpx;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f1f5f9;
}

.info-item .label { color: #64748b; }
.info-item .value { color: #2563eb; }

.btn-group {
  display: flex;
  gap: 20rpx;
  padding: 0 30rpx 50rpx 30rpx;
}

.btn {
  flex: 1;
  font-size: 28rpx;
  border-radius: 40rpx;
  border: none;
}

.btn-primary { background: #2563eb; color: #fff; }
.btn-secondary { background: #e2e8f0; color: #334155; }